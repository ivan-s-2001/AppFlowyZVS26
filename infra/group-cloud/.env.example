# Do not commit real values.

# PostgreSQL
APPFLOWY_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Redis
APPFLOWY_REDIS_URI=rediss://default:PASSWORD@HOST:PORT

# Auth / GoTrue
APPFLOWY_GOTRUE_BASE_URL=https://PROJECT.supabase.co/auth/v1
APPFLOWY_GOTRUE_JWT_SECRET=replace_me

# S3-compatible storage
APPFLOWY_S3_USE_MINIO=true
APPFLOWY_S3_CREATE_BUCKET=false
APPFLOWY_S3_MINIO_URL=https://PROJECT.storage.supabase.co/storage/v1/s3
APPFLOWY_S3_ACCESS_KEY=replace_me
APPFLOWY_S3_SECRET_KEY=replace_me
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=replace_me

# Public Cloudflare gateway, not the Render origin.
APPFLOWY_BASE_URL=https://zvs26-api.example
